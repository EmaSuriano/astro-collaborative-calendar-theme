---
import { appConfig } from '../config';
---

<section class="hero" aria-label="Calendar events title">
  <div class="hero-inner">
    <div class="logo" aria-hidden="true">
      <svg viewBox="0 0 64 64" width="88" height="88" role="img">
        <rect x="6" y="10" width="52" height="48" rx="10" fill="currentColor" opacity="0.12"></rect>
        <rect x="10" y="16" width="44" height="38" rx="8" fill="white"></rect>
        <rect x="10" y="16" width="44" height="12" rx="8" fill="currentColor"></rect>
        <circle cx="22" cy="40" r="3.2" fill="currentColor"></circle>
        <circle cx="32" cy="40" r="3.2" fill="currentColor"></circle>
        <circle cx="42" cy="40" r="3.2" fill="currentColor"></circle>
      </svg>
    </div>

    <h1>{appConfig.title}</h1>
    <p class="subtitle">{appConfig.subTitle}</p>
    <p class="lede">
      This is a collaborative event calendar for meetups and community organizers.
      Everyone sees the same public schedule — add yours with the form, and it
      lands on the calendar after the next site rebuild.
    </p>

    <div class="actions">
      <a class="button primary" href="#calendars">See all the events</a>
      <a
        class="button secondary"
        href={appConfig.formLink}
        target="_blank"
        rel="noopener noreferrer"
      >
        Add your event!
      </a>
    </div>

    <p class="source">
      Events are loaded from a
      <a href={appConfig.spreadsheetLink} target="_blank" rel="noopener noreferrer">
        Google Spreadsheet
      </a>.
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 5rem 1.25rem 3rem;
    text-align: center;
  }

  .hero-inner {
    width: min(720px, 100%);
  }

  .logo {
    color: var(--brand);
    margin-bottom: 1.25rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .subtitle {
    margin: 1rem 0 0;
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    color: var(--muted);
    font-weight: 600;
  }

  .lede {
    margin: 1.25rem auto 0;
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .primary {
    background: var(--brand);
    color: white;
    box-shadow: 0 10px 24px rgba(15, 118, 110, 0.25);
  }

  .primary:hover,
  .primary:focus-visible {
    background: var(--brand-dark);
  }

  .secondary {
    background: transparent;
    color: var(--brand-dark);
    border: 2px solid var(--brand);
  }

  .secondary:hover,
  .secondary:focus-visible {
    background: rgba(15, 118, 110, 0.08);
  }

  .source {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .source a {
    color: var(--brand-dark);
    font-weight: 600;
  }
</style>
